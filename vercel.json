{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "framework": null,
  "installCommand": "",
  "buildCommand": "node --test tests/*.test.mjs && node scripts/build-deployment.mjs",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/build\\.json",
      "dest": "/404.html",
      "status": 404
    },
    {
      "handle": "filesystem"
    }
  ]
}
